---
import Legacy from "../layouts/Legacy.astro";
import DSBWidgets from "../components/dsbwidgets";
import OnlineIndicator from "../components/onlineindicator";

import "./_style.css";

const version = "v2.8.1";
---

<Legacy
    title="DSB Vertretungsplan"
    icon="/bird.png"
    version={version}
    manifest="/dsb.webmanifest"
>
