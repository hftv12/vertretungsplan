---
import Header from "../components/header"
import Footer from "../components/footer"
import BottomNav from "../components/bottomnav"

interface Props {
	title: string,
	icon: string | ImageMetadata,
	version: string,
	manifest: string,
}

const { title, icon, version, manifest } = Astro.props;
---

<!DOCTYPE html>
<html lang="de">
	<head>
		<meta charset="UTF-8" />
		<link rel="icon" type="image/png" href={typeof icon === "string" ? icon : icon.src} />
		{!!manifest && <link rel="manifest" href={manifest} />}
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<script is:inline>
			try {
				const s = localStorage.getItem("DSBSettings");
				if (s) {
					const parsed = JSON.parse(s);
					if (parsed.theme) document.documentElement.setAttribute('data-theme', parsed.theme);
					if (parsed.colorTheme) document.documentElement.setAttribute('data-color-theme', parsed.colorTheme);
				}
			} catch (e) {}
		</script>
	</head>
	<body>
		<div id="wrapper">
			<div id="header" style="position: sticky; top: 0; z-index: 100;">
				<Header text="DSB Mobile 2.0" homepage='..' logo={icon} width="64" height="64" pixel={true} version={version} client:only>
				</Header>
				<div class="top-fade"></div>
			</div>
			<div id="main-content">
				<div class='center'>
					<div class='main'>
						<slot />
					</div>
				</div>
            </div>
			<div id="footer">
				<Footer />
			</div>
			<div class="bottom-fade"></div>
			<BottomNav client:only />
		</div>
	</body>
</html>
